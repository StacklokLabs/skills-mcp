{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "docker:enableMajor",
    "docker:pinDigests"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 9am on monday"],
  "timezone": "America/New_York",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Group Python dev dependencies",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dev"],
      "groupName": "python-dev-dependencies"
    },
    {
      "description": "Group Python doc dependencies",
      "matchManagers": ["pep621"],
      "matchPackagePatterns": ["mkdocs.*"],
      "groupName": "python-docs-dependencies"
    },
    {
      "description": "Group Docker base image updates",
      "matchManagers": ["dockerfile"],
      "groupName": "docker-base-images"
    },
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor updates for dev dependencies",
      "matchDepTypes": ["dev"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    }
  ]
}
